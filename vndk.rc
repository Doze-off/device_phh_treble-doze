on post-fs
    exec - root -- /system/bin/vndk-detect
    exec - root -- /system/bin/rw-system.sh
    mount none /system/etc/usb_audio_policy_configuration.xml /vendor/etc/usb_audio_policy_configuration.xml bind
    setprop ro.vndk.version ${persist.sys.vndk}

    start watchdogd-gsi

    # Clear old persistent codec properties to prevent conflicts
    # Remove previously saved values that may overwrite new configurations
    exec u:r:phhsu_daemon:s0 root -- rm -f /data/property/persist.sys.phh.prefer_hw_codecs
    exec u:r:phhsu_daemon:s0 root -- rm -f /data/property/persist.sys.phh.prefer_sw_codecs
    exec u:r:phhsu_daemon:s0 root -- rm -f /data/property/persist.sys.phh.fix_screen_recorder
    exec u:r:phhsu_daemon:s0 root -- rm -f /data/property/persist.sys.phh.max_compatibility
    exec u:r:phhsu_daemon:s0 root -- rm -f /data/property/persist.sys.phh.legacy_mode
    exec u:r:phhsu_daemon:s0 root -- rm -f /data/property/persist.sys.phh.max_performance

on property:vold.decrypt=trigger_restart_framework
    exec - root -- /system/bin/phh-on-data.sh

on early-boot
    exec - root -- /system/bin/phh-on-data.sh

service phh_on_boot /system/bin/phh-on-boot.sh
    oneshot
    disabled

service power_mode_monitor /system/bin/power-mode-monitor.sh
    oneshot
    disabled
    seclabel u:r:phhsu_daemon:s0

on property:sys.boot_completed=1
    start phh_on_boot
    start power_mode_monitor
    chown wifi system /data/misc/wifi
    chown system wifi /data/misc/wifi/hostapd.conf

on property:persist.sys.phh.mainkeys=*
    setprop qemu.hw.mainkeys ${persist.sys.phh.mainkeys}

on property:persist.sys.phh.asus.dt2w=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.asus.dt2w"

on property:persist.sys.phh.asus.usb.port=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.asus.usb.port"

on property:persist.sys.phh.oppo.dt2w=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.oppo.dt2w"

on property:persist.sys.phh.oppo.gaming_mode=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.oppo.gaming_mode"

on property:sys.phh.oplus.fppress=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "sys.phh.oplus.fppress"

on property:persist.sys.phh.securize=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.securize"

on property:persist.sys.phh.oppo.usbotg=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.oppo.usbotg"

on property:persist.sys.phh.oppo.dc_dimming=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.oppo.dc_dimming"

on property:persist.sys.phh.transsion.usbotg=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.transsion.usbotg"

on property:persist.sys.phh.transsion.dt2w=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.transsion.dt2w"

on property:persist.sys.phh.xiaomi.dt2w=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.xiaomi.dt2w"

on property:persist.sys.phh.allow_binder_thread_on_incoming_calls=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.allow_binder_thread_on_incoming_calls"

on property:persist.sys.phh.disable_audio_effects=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.disable_audio_effects"

on property:persist.sys.phh.caf.audio_policy=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.caf.audio_policy"

on property:persist.sys.phh.vsmart.dt2w=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.vsmart.dt2w"

on property:persist.sys.phh.backlight.scale=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.backlight.scale"

on property:persist.sys.phh.disable_soundvolume_effect=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.disable_soundvolume_effect"

# ro.sf.lcd_density is set by rw-system.sh during post-fs, before
# surfaceflinger starts.  the previous `restart surfaceflinger` here
# killed the already-running SF to pick up the new density, but that
# caused the DRM pipeline to reset without a clean panel power-off.
# on devices with an external backlight IC (e.g. ktz8866) the kernel
# panel driver's state tracking desyncs from the hardware: it believes
# the bias/boost is still enabled from the bootloader, so the power-on
# path in the second SF never calls bias_enable(1).  the backlight IC
# stays off and the display is permanently blank.
#
# removing the restart is safe because rw-system.sh runs before
# class_start core, so ro.sf.lcd_density is already set when SF reads
# it during init().
#on property:ro.sf.lcd_density=*
#    restart surfaceflinger

on property:persist.bluetooth.system_audio_hal.enabled=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.bluetooth.system_audio_hal.enabled"

on property:init.svc.ril-proxy=stopped && property:persist.sys.phh.restart_ril=true
    start ril-proxy

on property:init.svc.vendor.ril-daemon-mtk=stopped && property:persist.sys.phh.restart_ril=true
    start vendor.ril-daemon-mtk

on property:persist.sys.phh.restart_ril=true
    restart ril-proxy
    restart vendor.qcrild
    restart vendor.qcrild2
    restart vendor.ril-daemon-mtk

on property:vendor.debug.sf.latch_unsignaled=1
    setprop debug.sf.latch_unsignaled 1

on property:sys.phh.uninstall-ota=true
    exec u:r:phhsu_daemon:s0 root -- /system/bin/rm /metadata/phh/img

on property:ro.vendor.radio.default_network=*
    setprop ro.telephony.default_network ${ro.vendor.radio.default_network}

on property:persist.sys.phh.force_display_5g=1
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh ro.telephony.default_network 26

on property:persist.sys.phh.ims.floss=true
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh ro.telephony.iwlan_operation_mode AP-assisted

on property:persist.sys.phh.enable_sf_gl_backpressure=*
    setprop debug.sf.enable_gl_backpressure ${persist.sys.phh.enable_sf_gl_backpressure}

on property:persist.sys.phh.enable_sf_hwc_backpressure=*
    setprop debug.sf.enable_hwc_backpressure ${persist.sys.phh.enable_sf_hwc_backpressure}

on property:persist.sys.phh.lmk_tweaks=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.lmk_tweaks"

on property:persist.sys.phh.scroll_boost=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.scroll_boost"

on property:persist.sys.phh.axion_props=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.axion_props"

on property:persist.sys.phh.bluetooth_fix=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.bluetooth_fix"

on property:persist.sys.activity_anim_perf_override=true
     exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh debug.sf.predict_hwc_composition_strategy 0

# Prefer HW codecs (vendor HIDL C2 + OMX, default behavior)
# BEST FOR PERFORMANCE - Recommended for most devices
# - ccodec=4: All C2 components available at normal ranks (C2 + OMX)
# - omx_default_rank=0: OMX at maximum priority (rank 0x0, first choice)
# - hal.selection=hidl: Use vendor HIDL C2 HAL for hardware acceleration
# - c2inputsurface=-1: Enable all input surface backends (HW C2, OMX, SW C2)
# Performance: ⭐⭐⭐⭐⭐ | Compatibility: ⭐⭐⭐⭐ | CPU Usage: Low | Battery: Excellent
# Use this mode if video recording works normally on your device
on property:persist.sys.phh.prefer_hw_codecs=true
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh debug.stagefright.c2inputsurface -1
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh debug.stagefright.ccodec 4
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh debug.stagefright.omx_default_rank 0
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh media.c2.hal.selection hidl

# Prefer SW codecs (force c2.android.* only, like doissM's CodecFix)
# USE ONLY IF HW CODECS FAIL - Higher CPU usage but more compatible
# - ccodec=4: All C2 components available (C2 + OMX)
# - omx_default_rank=0: OMX at maximum priority (rank 0x0)
# - hal.selection=aidl: Use AIDL C2 HAL (system-side c2.android.* software codecs)
# - c2inputsurface=-1: Enable all input surface backends
# Performance: ⭐⭐⭐ | Compatibility: ⭐⭐⭐⭐⭐ | CPU Usage: High | Battery: Fair
# Enable ONLY if video recording crashes, hangs, or produces corrupted files with HW codecs
# WARNING: Significantly higher CPU usage and battery drain
on property:persist.sys.phh.prefer_sw_codecs=true
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh debug.stagefright.c2inputsurface -1
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh debug.stagefright.ccodec 4
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh debug.stagefright.omx_default_rank 0
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh media.c2.hal.selection aidl

# Fix screen recorder (intermediate OMX rank to help some vendors)
# FOR SCREEN RECORDING ISSUES ONLY - Compatibility mode for input surface
# - ccodec=4: All C2 components available (C2 + OMX)
# - omx_default_rank=256: OMX at standard rank (0x100, balanced with C2 SW)
# - hal.selection=hidl: Use vendor HIDL C2 HAL
# - c2inputsurface=-1: Enable all input surface backends
# Performance: ⭐⭐⭐⭐ | Compatibility: ⭐⭐⭐⭐⭐ | CPU Usage: Medium | Battery: Good
# Enable if screen recorder shows black screen, crashes, or fails to start
# This mode prioritizes software codecs for input surface creation
on property:persist.sys.phh.fix_screen_recorder=true
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh debug.stagefright.c2inputsurface -1
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh debug.stagefright.ccodec 4
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh debug.stagefright.omx_default_rank 256
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh media.c2.hal.selection hidl

# Max compatibility (C2 enabled, but OMX prioritized for maximum compatibility)
# BALANCED MODE - C2 available but OMX preferred for old devices
# - ccodec=4: All C2 components available (C2 + OMX work together)
# - omx_default_rank=512: OMX at lower priority (0x200, below C2 software but still used)
# - hal.selection=hidl: Use vendor HIDL C2 HAL
# - c2inputsurface=-1: Enable all input surface backends
# Performance: ⭐⭐⭐ | Compatibility: ⭐⭐⭐⭐⭐ | CPU Usage: Medium-High | Battery: Fair
# Enable if video recording or screen recorder fails with other modes
# Good for older devices (Android 10-) or devices with buggy C2 implementation
# C2 is available as fallback, but OMX codecs are preferred
on property:persist.sys.phh.max_compatibility=true
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh debug.stagefright.c2inputsurface -1
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh debug.stagefright.ccodec 4
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh debug.stagefright.omx_default_rank 512
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh media.c2.hal.selection hidl

# Legacy mode (force OMX legacy path, C2 disabled)
# FOR ANDROID 9 OR BOOTLOOPS ONLY - Disables Codec2 completely
# - ccodec=0: Only OMX components available (C2 completely disabled)
# - omx_default_rank=0: OMX at maximum priority (rank 0x0, only option)
# - hal.selection=hidl: Use vendor HIDL C2 HAL (though C2 is disabled by ccodec=0)
# - c2inputsurface=-1: Enable all input surface backends
# Performance: ⭐⭐ | Compatibility: ⭐⭐⭐⭐ | CPU Usage: High | Battery: Poor
# Enable ONLY for Android 9 or older devices
# Use if C2 causes bootloop, system crash, or severe instability
# WARNING: Slowest mode, highest CPU usage, avoid unless necessary
on property:persist.sys.phh.legacy_mode=true
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh debug.stagefright.c2inputsurface -1
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh debug.stagefright.ccodec 0
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh debug.stagefright.omx_default_rank 0
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh media.c2.hal.selection hidl

# Max performance (C2 hardware first, OMX as last resort)
# MAXIMUM PERFORMANCE - For modern devices with stable C2 implementation
# - ccodec=4: All C2 components available (C2 + OMX)
# - omx_default_rank=1024: OMX at very low priority (0x400, last resort)
# - hal.selection=hidl: Use vendor HIDL C2 HAL for maximum hardware acceleration
# - c2inputsurface=-1: Enable all input surface backends
# Performance: ⭐⭐⭐⭐⭐ | Compatibility: ⭐⭐⭐ | CPU Usage: Lowest | Battery: Best
# Enable ONLY for Android 11+ devices with stable C2 implementation
# Use if you want maximum encoding speed and battery efficiency
# WARNING: May cause compatibility issues on older devices or buggy C2 implementations
on property:persist.sys.phh.max_performance=true
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh debug.stagefright.c2inputsurface -1
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh debug.stagefright.ccodec 4
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh debug.stagefright.omx_default_rank 1024
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh media.c2.hal.selection hidl

# Latch Unsigned Buffers
on property:persist.sys.phh.sf_latch_unsignaled=*
    setprop debug.sf.latch_unsignaled ${persist.sys.phh.sf_latch_unsignaled}

# Auto Latch Unsigned
on property:persist.sys.phh.sf_auto_latch_unsignaled=*
    setprop debug.sf.auto_latch_unsignaled ${persist.sys.phh.sf_auto_latch_unsignaled}

# Disable Backpressure
on property:persist.sys.phh.sf_disable_backpressure=*
    setprop debug.sf.disable_backpressure ${persist.sys.phh.sf_disable_backpressure}

on property:persist.sys.phh.sf.background_blur=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.sf.background_blur"

on property:persist.sys.phh.dynamic_fps=*
    setprop ro.surface_flinger.use_content_detection_for_refresh_rate ${persist.sys.phh.dynamic_fps}

on property:persist.sys.phh.sf.debug.renderengine.backend=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.sf.debug.renderengine.backend"

on property:persist.sys.phh.sf.renderengine.backend=*
    exec u:r:phhsu_daemon:s0 root -- /system/bin/phh-prop-handler.sh "persist.sys.phh.sf.renderengine.backend"

# Set watchdog timer to 30 seconds and pet it every 10 seconds to get a 20 second margin
service watchdogd-gsi /system/bin/watchdogd 10 20
    class core
    oneshot
    disabled
    seclabel u:r:watchdogd:s0

# reset oem unlock toggle to disable
on property:sys.oem_unlock_allowed=*
    exec u:r:magisk:s0 root root -- /system/bin/resetprop_phh -n sys.oem_unlock_allowed 0
